    "# =============================================================================\n",
    "# VALIDATION N19 : D\u00e9calage Phase-Topologie\n",
    "# =============================================================================\n",
    "\n",
    "print('\ud83d\udd04 Validation N19: D\u00e9calage Phase-Topologie (Famille J)')\n",
    "\n",
    "from validation_functions import run_n19, plot_h1_bottleneck_vs_epsilon\n",
    "\n",
